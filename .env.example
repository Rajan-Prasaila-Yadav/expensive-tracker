# ==========================================
# 🔐 FinanceOS Environment Variables
# ==========================================

# Database Connection (Supabase / Neon PostgreSQL)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@[YOUR-HOST]:5432/postgres?sslmode=require"

# Django Backend Configuration
DJANGO_SECRET_KEY="django-insecure-your-super-secret-production-key-here"
DEBUG="True"
ALLOWED_HOSTS="localhost,127.0.0.1,.railway.app,.onrender.com,.vercel.app"
CORS_ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,https://your-frontend.vercel.app"

# Supabase Auth
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Frontend API Target (Optional for production standalone builds)
VITE_API_URL="http://localhost:8000/api"
